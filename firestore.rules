rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(docData) {
      return isSignedIn() && docData.keys().hasAll(['userId']) && docData.userId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "zaimzaidi04@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Entity Validators
    function isValidClient(data) {
      return data.keys().hasAll(['name', 'userId', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['clientId', 'userId', 'date', 'eventType', 'price', 'status', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.clientId is string &&
             data.userId == request.auth.uid &&
             data.price is number && data.price >= 0 &&
             data.status in ['Booked', 'Shot', 'Editing', 'Review', 'Delivered'] &&
             data.createdAt == request.time;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['bookingId', 'userId', 'amount', 'date', 'type', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.amount is number &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['userId', 'amount', 'date', 'description', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.amount is number &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // Collection Rules
    match /clients/{clientId} {
      allow get: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow list: if isSignedIn() && (!resource.data.keys().hasAll(['userId']) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow delete: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
    }

    match /bookings/{bookingId} {
      allow get: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow list: if isSignedIn() && (!resource.data.keys().hasAll(['userId']) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(bookingId) && isValidBooking(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId));
      allow update: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow delete: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
    }

    match /payments/{paymentId} {
      allow get: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow list: if isSignedIn() && (!resource.data.keys().hasAll(['userId']) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(paymentId) && isValidPayment(incoming()) &&
                      exists(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow delete: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
    }

    match /expenses/{expenseId} {
      allow get: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
      allow list: if isSignedIn() && (!resource.data.keys().hasAll(['userId']) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if (isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']))) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'date', 'description', 'category']);
      allow delete: if isOwner(existing()) || isAdmin() || (isSignedIn() && !existing().keys().hasAll(['userId']));
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['number', 'userId', 'clientName', 'items', 'total', 'createdAt']) &&
             data.keys().size() <= 25 &&
             data.userId == request.auth.uid &&
             data.number is string && data.number.size() <= 32 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 120 &&
             data.items is list && data.items.size() <= 50 &&
             data.total is number &&
             data.createdAt == request.time;
    }

    // Per-user invoice number counter: counters/{uid}
    match /counters/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
                              incoming().userId == userId &&
                              incoming().keys().hasOnly(['userId', 'invoiceSeq', 'updatedAt']) &&
                              incoming().invoiceSeq is map;
    }

    // Issued invoices. Immutable once issued (delete allowed, no edits).
    match /invoices/{invoiceId} {
      allow get: if isOwner(existing()) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(invoiceId) &&
                      invoiceId == request.auth.uid + '_' + incoming().number &&
                      isValidInvoice(incoming());
      allow delete: if isOwner(existing()) || isAdmin();
    }
  }
}
